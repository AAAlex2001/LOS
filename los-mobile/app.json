{
  "expo": {
    "name": "Land of Soul",
    "slug": "land-of-soul",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "losmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#010E59"
    },
    "ios": {
      "icon": "./assets/icons/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "ru.landofsoulapsny.losmobile",
      "buildNumber": "38",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icons/icon.png",
      "splash": {
        "backgroundColor": "#010E59"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-android.png",
        "backgroundColor": "#010E59"
      },
      "edgeToEdgeEnabled": true,
      "package": "ru.landofsoulapsny.losmobile",
      "versionCode": 37,
      "newArchEnabled": true
    },
    "androidStatusBar": {
      "backgroundColor": "#010E59",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#010E59",
          "image": "./assets/images/logo_splash.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#010E59"
        }
      ],
      "expo-font",
      ["./plugins/withIOSBackgroundColor", "#010E59"],
      "./plugins/withAndroidLockFontScale"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8601fec5-9ea4-4585-8136-3ad236ea27fe"
      }
    },
    "owner": "glisttt"
  }
}
