{
  "expo": {
    "name": "los-mobile",
    "slug": "los-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "losmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#010E59"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.landofsoulapsny.losmobile",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "splash": {
        "image": "./assets/images/logo_splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#010E59"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.losmobile",
      "newArchEnabled": true
    },
    "androidStatusBar": {
      "backgroundColor": "#010E59",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#010E59"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a51edae-0ab8-4856-ac5d-844332f005d5"
      }
    }
  }
}
