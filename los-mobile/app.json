{
  "expo": {
    "name": "Land of Soul",
    "slug": "land-of-soul",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "losmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#010E59"
    },
    "ios": {
      "icon": "./assets/icons/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "ru.landofsoulapsny.losmobile",
      "buildNumber": "14",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icons/icon.png",
      "splash": {
        "image": "./assets/images/logo_splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#010E59"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.losmobile",
      "newArchEnabled": true
    },
    "androidStatusBar": {
      "backgroundColor": "#010E59",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_splash.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#010E59"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37c45080-d3fd-4e5c-a6c3-b34211546ce0"
      }
    }
  }
}
